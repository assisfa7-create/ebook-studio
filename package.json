{
  "name": "ebook-studio",
  "version": "1.0.0",
  "description": "Estudio de criacao de e-books com IA",
  "main": "electron/main.js",
  "author": "Franc",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "dev": "vite",
    "icon": "electron electron/make-icon.js",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.460.0",
    "png2icons": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.franc.ebookstudio",
    "productName": "Ebook Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "EbookStudio-Setup-${version}.${ext}"
    }
  }
}
